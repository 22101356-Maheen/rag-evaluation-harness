# app settings
APP_NAME=RAG Evaluation Harness
ENVIRONMENT=development

# database settings
QDRANT_URL=http://localhost:6335
DATABASE_URL=postgresql+psycopg://username:password@localhost:5433/database_name


# clerk settings
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# test auth settings
USE_TEST_AUTH=true

# API keys and model settings
GROQ_API_KEY=your_real_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

GENERATION_MODEL=openai/gpt-oss-20b
EVALUATION_MODEL=openai/gpt-oss-120b
SYNTHETIC_DATASET_MODEL=openai/gpt-oss-20b

LLM_TIMEOUT_SECONDS=30
LLM_CONTEXT_TOKEN_BUDGET=4000
DEFAULT_EVALUATION_CASE_COUNT=8
EVALUATION_PROMPT_VERSION=day9-v1